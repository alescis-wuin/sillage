{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sillage:development:schemas:v1:phase-start",
  "title": "Manifeste déclaratif de préparation d'une phase de développement Sillage v1",
  "$defs": {
    "gitsha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(type:(feature|fix|refactor|docs|chore)|phase:[0-9]+)$"
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 160 },
        "body": { "type": "string", "minLength": 30, "maxLength": 12000 },
        "labels": { "$ref": "#/$defs/labels" }
      },
      "required": ["title", "body", "labels"]
    },
    "step_issue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step_id": { "type": "string", "pattern": "^E[0-9]{2}$" },
        "title": { "type": "string", "minLength": 3, "maxLength": 160 },
        "body": { "type": "string", "minLength": 30, "maxLength": 12000 },
        "labels": { "$ref": "#/$defs/labels" }
      },
      "required": ["step_id", "title", "body", "labels"]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "sillage-development-phase-start" },
    "project": { "const": "sillage" },
    "phase": { "type": "string", "pattern": "^P[0-9]{2}$" },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "github_repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "base_branch": { "const": "develop" },
        "expected_head": { "$ref": "#/$defs/gitsha" },
        "work_branch": {
          "type": "string",
          "pattern": "^(feature|fix|refactor|docs|chore)/[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "require_clean_worktree": { "const": true },
        "require_personal_commit_signature": { "const": true }
      },
      "required": [
        "github_repository", "base_branch", "expected_head", "work_branch",
        "require_clean_worktree", "require_personal_commit_signature"
      ]
    },
    "issues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parent": { "$ref": "#/$defs/issue" },
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/step_issue" }
        }
      },
      "required": ["parent", "steps"]
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "smart_english_source": { "const": "SMART.en.md" },
        "smart_english_sha256": { "$ref": "#/$defs/digest" },
        "smart_target": {
          "type": "string",
          "pattern": "^docs/phase-[0-9]{2}/SMART\\.md$"
        }
      },
      "required": ["smart_english_source", "smart_english_sha256", "smart_target"]
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "const": "phase-start" }
      },
      "required": ["profile"]
    }
  },
  "required": ["schema_version", "kind", "project", "phase", "git", "issues", "documents", "checks"]
}
